{
  "name": "@octogee/octogee-api",
  "version": "1.0.0",
  "description": "Octogee cluster-singleton API \u2014 non-locality routes lifted out of gateway-edge",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/octogee-api/src/main.js",
  "scripts": {
    "prebuild": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "build": "tsc && tsc-alias -p tsconfig.json && npm run verify:no-alias-leakage",
    "build:watch": "tsc --watch",
    "start": "node dist/octogee-api/src/main.js",
    "start:npm-cache-proxy": "node dist/octogee-api/src/npm-cache-proxy.js",
    "dev": "OCTOGEE_ALLOW_LOCAL_ORIGINS=true tsx watch src/main.ts",
    "pretest": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test": "vitest run --exclude 'src/__tests__/**/*.emulator.spec.ts'",
    "pretest:watch": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:watch": "vitest --exclude 'src/__tests__/**/*.emulator.spec.ts'",
    "pretest:emulator": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:emulator": "node ../scripts/ops/run-emulator-vitest.mjs --only firestore,auth --project demo-platform --firebase-config ../../firebase.json --config vitest.emulator.config.ts --env GCLOUD_PROJECT=demo-platform",
    "pretest:emulator:one": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:emulator:one": "node ../scripts/ops/run-emulator-vitest.mjs --only firestore,auth --project demo-platform --firebase-config ../../firebase.json --config vitest.emulator.config.ts --env GCLOUD_PROJECT=demo-platform",
    "test:all": "npm test && npm run test:emulator",
    "pretest:coverage": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "typecheck": "tsc --noEmit",
    "verify:no-alias-leakage": "! grep -rq --include='*.js' '@shared' dist/ || (echo '\u274c Found un-rewritten @shared/* alias in compiled JS.' && exit 1)"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/client-sts": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@google-cloud/kms": "^6.3.0",
    "@google-cloud/secret-manager": "^7.0.0",
    "@octogee/core": "file:../core",
    "@octogee/shared": "file:../shared",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "obsidian-headless": "0.0.14",
    "prom-client": "^15.1.3",
    "resend": "^6.37.0",
    "sharp": "^0.35.5",
    "undici": "^8.12.4",
    "unique-names-generator": "^4.7.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@octogee/test-helpers": "file:../test-helpers",
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.1.0",
    "firebase-tools": "^15.35.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@firebase/util": false,
    "better-sqlite3": true,
    "esbuild": false,
    "protobufjs": false,
    "re2": false
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.1.6",
      "hono": "^4.13.11"
    },
    "@protobufjs/utf8": "^1.1.1",
    "@tootallnate/once": "^3.0.1",
    "brace-expansion@<2.0.0": "1.1.21",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
    "fast-xml-builder": "^1.1.7",
    "fast-uri": "^3.1.6",
    "glob": "14.0.3",
    "ip-address": "^10.2.1",
    "qs": "^6.17.0",
    "protobufjs": "^7.6.3",
    "re2": "1.26.1",
    "uuid": "^14.0.0",
    "js-yaml": "^4.3.1",
    "@opentelemetry/core": "^2.8.0",
    "esbuild": "^0.28.1",
    "postcss": "8.5.25",
    "undici@<7.0.0": "^6.28.0",
    "firebase-tools": {
      "csv-parse": "^7.0.2"
    },
    "basic-ftp": "^6.2.1"
  }
}
