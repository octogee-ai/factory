{
  "name": "@octogee/octogee-api",
  "version": "1.0.0",
  "description": "Octogee cluster-singleton API — non-locality routes lifted out of gateway-edge (POST-BENDER-CLEANUP-SPEC §2)",
  "type": "module",
  "main": "dist/octogee-api/src/index.js",
  "scripts": {
    "prebuild": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "build": "tsc && tsc-alias -p tsconfig.json && npm run verify:no-alias-leakage",
    "build:watch": "tsc --watch",
    "start": "node dist/octogee-api/src/index.js",
    "dev": "tsx watch src/index.ts",
    "pretest": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test": "vitest run --exclude 'src/__tests__/**/*.emulator.spec.ts'",
    "pretest:watch": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:watch": "vitest --exclude 'src/__tests__/**/*.emulator.spec.ts'",
    "pretest:emulator": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:emulator": "node ../scripts/ops/run-emulator-vitest.mjs --only firestore,auth --project octogee-test --firebase-config ../firebase.json --config vitest.emulator.config.ts --env GCLOUD_PROJECT=octogee-test",
    "pretest:emulator:one": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:emulator:one": "node ../scripts/ops/run-emulator-vitest.mjs --only firestore,auth --project octogee-test --firebase-config ../firebase.json --config vitest.emulator.config.ts --env GCLOUD_PROJECT=octogee-test",
    "test:all": "npm test && npm run test:emulator",
    "pretest:coverage": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "typecheck": "tsc --noEmit",
    "verify:no-alias-leakage": "! grep -rq --include='*.js' '@shared' dist/ || (echo '❌ Found un-rewritten @shared/* alias in compiled JS.' && exit 1)"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1087.0",
    "@google-cloud/kms": "^5.6.0",
    "@google-cloud/secret-manager": "^6.1.2",
    "@octogee/core": "file:../core",
    "@octogee/shared": "file:../shared",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.3.0",
    "jszip": "^3.10.1",
    "prom-client": "^15.1.3",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "stripe": "^22.3.1",
    "undici": "^8.7.0",
    "unique-names-generator": "^4.7.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@octogee/test-helpers": "file:../test-helpers",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "firebase-tools": "^15.23.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "@tootallnate/once": "^3.0.1",
    "fast-xml-builder": "^1.1.7",
    "glob": "^13.0.0",
    "ip-address": "^10.1.1",
    "protobufjs": "^7.6.3",
    "uuid": "^14.0.0",
    "tar": "^7.5.16",
    "js-yaml": "^4.2.0",
    "@opentelemetry/core": "^2.8.0",
    "esbuild": "^0.28.1"
  }
}
