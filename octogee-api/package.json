{
  "name": "@octogee/octogee-api",
  "version": "1.0.0",
  "description": "Octogee cluster-singleton API — non-locality routes lifted out of gateway-edge (POST-BENDER-CLEANUP-SPEC §2)",
  "type": "module",
  "main": "dist/octogee-api/src/index.js",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json && npm run verify:no-alias-leakage",
    "build:watch": "tsc --watch",
    "start": "node dist/octogee-api/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --exclude 'src/__tests__/**/*.emulator.spec.ts'",
    "test:watch": "vitest --exclude 'src/__tests__/**/*.emulator.spec.ts'",
    "test:emulator": "GCLOUD_PROJECT=octogee-test firebase emulators:exec --only firestore,auth --project=octogee-test 'GCLOUD_PROJECT=octogee-test npx vitest run --config vitest.emulator.config.ts'",
    "test:all": "npm test && npm run test:emulator",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:no-alias-leakage": "! grep -rq --include='*.js' '@shared' dist/ || (echo '❌ Found un-rewritten @shared/* alias in compiled JS.' && exit 1)"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1068.0",
    "@google-cloud/kms": "^5.5.0",
    "@google-cloud/secret-manager": "^6.1.2",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "prom-client": "^15.1.3",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "stripe": "^22.1.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "firebase-tools": "^15.18.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "@tootallnate/once": "^3.0.1",
    "fast-xml-builder": "^1.1.7",
    "glob": "^13.0.0",
    "ip-address": "^10.1.1",
    "protobufjs": "^7.6.3",
    "uuid": "^14.0.0",
    "tar": "^7.5.16",
    "js-yaml": "^4.2.0",
    "@opentelemetry/core": "^2.8.0",
    "esbuild": "^0.28.1"
  }
}
