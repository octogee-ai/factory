{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2022",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "skipLibCheck": true,
    "noUnusedLocals": false
  },
  "include": [
    "src/**/*.ts",
    "../gateway-edge/src/**/*.ts"
  ],
  "exclude": [
    "src/__tests__",
    "node_modules",
    "dist",
    "../gateway-edge/src/**/__tests__/**/*",
    "../gateway-edge/src/chat-proxy/**",
    "../gateway-edge/src/index.ts"
  ]
}
