{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2022",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../shared/types/**/*.ts",
    "../gateway-edge/src/**/*.ts",
    "../scripts/lib/admin-fleet-router.ts",
    "../scripts/lib/secret-manager.ts",
    "../scripts/lib/artifact-registry.ts",
    "../scripts/lib/workspace-slugs.ts"
  ],
  "exclude": [
    "src/__tests__",
    "node_modules",
    "dist",
    "../shared/**/*.spec.ts",
    "../gateway-edge/src/**/__tests__/**/*"
  ]
}
