{
  "cases": [
    {
      "name": "steer",
      "projections": [
        {
          "schemaVersion": 3,
          "projectionKind": "run",
          "conversationId": "main-1",
          "turnId": "turn-1",
          "runId": "run-1",
          "origin": "human",
          "status": "running",
          "mainChannelId": "main-1",
          "mainRootPostId": "turn-1",
          "inputPostId": "steer-1",
          "activityChannelId": "activity-1",
          "activityRootPostId": "activity-root-1",
          "attention": "routine"
        }
      ],
      "expected": { "turnId": "turn-1", "runId": "run-1", "inputPostId": "steer-1" }
    },
    {
      "name": "retry",
      "projections": [
        {
          "schemaVersion": 3,
          "projectionKind": "run",
          "conversationId": "main-1",
          "turnId": "turn-1",
          "runId": "run-2",
          "retryOfRunId": "run-1",
          "origin": "retry",
          "status": "running",
          "mainChannelId": "main-1",
          "mainRootPostId": "turn-1",
          "inputPostId": "retry-marker-1",
          "activityChannelId": "activity-1",
          "activityRootPostId": "activity-root-2",
          "attention": "routine"
        }
      ],
      "expected": { "turnId": "turn-1", "runId": "run-2", "retryOfRunId": "run-1", "origin": "retry" }
    },
    {
      "name": "subagent",
      "projections": [
        {
          "schemaVersion": 3,
          "projectionKind": "run",
          "conversationId": "main-1",
          "turnId": "turn-1",
          "runId": "run-child-1",
          "parentRunId": "run-2",
          "origin": "subagent",
          "status": "running",
          "mainChannelId": "main-1",
          "mainRootPostId": "turn-1",
          "activityChannelId": "activity-1",
          "activityRootPostId": "activity-child-root-1",
          "attention": "routine"
        }
      ],
      "expected": { "turnId": "turn-1", "runId": "run-child-1", "parentRunId": "run-2", "origin": "subagent" }
    },
    {
      "name": "scheduled",
      "projections": [
        {
          "schemaVersion": 3,
          "projectionKind": "run",
          "conversationId": "main-1",
          "turnId": "scheduled-root-1",
          "runId": "run-scheduled-1",
          "origin": "scheduled",
          "status": "running",
          "mainChannelId": "main-1",
          "mainRootPostId": "scheduled-root-1",
          "inputPostId": "scheduled-root-1",
          "activityChannelId": "activity-1",
          "activityRootPostId": "activity-scheduled-root-1",
          "attention": "routine"
        }
      ],
      "expected": { "turnId": "scheduled-root-1", "mainRootPostId": "scheduled-root-1", "origin": "scheduled" }
    },
    {
      "name": "queue-to-steer",
      "projections": [
        {
          "schemaVersion": 3,
          "projectionKind": "admission",
          "conversationId": "main-1",
          "turnId": "turn-queued-1",
          "mainChannelId": "main-1",
          "activityChannelId": "activity-1",
          "inputPostId": "input-queued-1",
          "origin": "followup",
          "status": "queued",
          "queuePosition": 1,
          "attention": "routine"
        },
        {
          "schemaVersion": 3,
          "projectionKind": "run",
          "conversationId": "main-1",
          "turnId": "turn-active-1",
          "runId": "run-active-1",
          "origin": "followup",
          "status": "running",
          "mainChannelId": "main-1",
          "mainRootPostId": "turn-active-1",
          "inputPostId": "input-queued-1",
          "activityChannelId": "activity-1",
          "activityRootPostId": "activity-active-root-1",
          "attention": "routine"
        }
      ],
      "expected": { "turnId": "turn-active-1", "runId": "run-active-1", "inputPostId": "input-queued-1" }
    }
  ],
  "degradationCases": [
    {
      "name": "late-activity",
      "available": ["main", "live"],
      "missing": ["activity-until-replay"],
      "expectedBehavior": "join-by-run-id-when-activity-arrives"
    },
    {
      "name": "missing-activity",
      "available": ["main", "live"],
      "missing": ["activity"],
      "expectedBehavior": "render-main-with-missing-activity-label"
    },
    {
      "name": "missing-live",
      "available": ["main", "activity"],
      "missing": ["live"],
      "expectedBehavior": "render-durable-history-without-live-hud"
    },
    {
      "name": "activity-only",
      "available": ["activity"],
      "missing": ["main", "live"],
      "expectedBehavior": "retain-run-detail-for-later-identity-join"
    }
  ]
}
