{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "../..",
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["*.ts", "ci/**/*.ts", "entrypoints/**/*.ts", "lib/**/*.ts", "ops/**/*.ts", "product/lib/**/*.ts", "product/ops/**/*.ts", "../shared/types/identity.ts"],
  "exclude": ["node_modules", "dist", "**/seed-*.ts", "**/generate-*.ts", "**/setup-*.ts", "../shared/**/*.spec.ts"]
}
