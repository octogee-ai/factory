{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "..",
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["*.ts", "lib/**/*.ts", "../shared/types/identity.ts"],
  "exclude": ["node_modules", "dist", "seed-*.ts", "generate-*.ts", "setup-*.ts", "../shared/**/*.spec.ts"]
}
