[
  {
    "name": "keep-pinned-and-release-pointers",
    "action": { "type": "Keep" },
    "condition": {
      "tagState": "tagged",
      "tagPrefixes": ["keep", "pin", "canonical", "latest"]
    }
  },
  {
    "name": "keep-recent-3-per-image",
    "action": { "type": "Keep" },
    "mostRecentVersions": { "keepCount": 3 }
  },
  {
    "name": "delete-untagged",
    "action": { "type": "Delete" },
    "condition": { "tagState": "untagged", "olderThan": "86400s" }
  },
  {
    "name": "delete-stale-tagged",
    "action": { "type": "Delete" },
    "condition": { "tagState": "tagged", "olderThan": "432000s" }
  }
]
