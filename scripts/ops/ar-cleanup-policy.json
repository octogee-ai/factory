[
  {
    "name": "keep-release-digest-manifests",
    "action": { "type": "Keep" },
    "condition": {
      "packageNamePrefixes": ["release-digest-manifest"]
    }
  },
  {
    "name": "keep-pinned-and-release-pointers",
    "action": { "type": "Keep" },
    "condition": {
      "tagState": "tagged",
      "tagPrefixes": ["keep", "pin", "canonical", "latest"]
    }
  },
  {
    "name": "keep-recent-2-per-image",
    "action": { "type": "Keep" },
    "mostRecentVersions": { "keepCount": 2 }
  },
  {
    "name": "delete-untagged",
    "action": { "type": "Delete" },
    "condition": { "tagState": "untagged", "olderThan": "1209600s" }
  }
]
