{
  "name": "@octogee/scripts",
  "version": "1.0.0",
  "description": "Octogee local tooling scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "provision": "tsx entrypoints/fleet-controller.ts",
    "fleet": "tsx ops/fleet.ts",
    "bump-gateway-imagetag": "tsx ops/bump-gateway-imagetag.ts",
    "pretest": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test": "npx vitest run __tests__",
    "pretest:emulator": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:emulator": "node ops/run-emulator-vitest.mjs --only firestore --project octogee-test --config vitest.emulator.config.ts --env GCLOUD_PROJECT=octogee-test",
    "pretest:emulator:one": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:emulator:one": "node ops/run-emulator-vitest.mjs --only firestore --project octogee-test --config vitest.emulator.config.ts --env GCLOUD_PROJECT=octogee-test",
    "audit-coverage": "tsx ops/audit-coverage.ts",
    "scope": "tsx ops/scope.ts"
  },
  "dependencies": {
    "@octogee/core": "file:../core/octogee-core.tgz",
    "@octogee/shared": "file:../shared/octogee-shared.tgz",
    "@types/http-proxy": "^1.17.17",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.9.0",
    "http-proxy": "^1.18.1",
    "node-pty": "^1.1.0",
    "stripe": "^22.3.0",
    "tsx": "^4.22.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.14",
    "firebase-tools": "^15.22.3",
    "supertest": "^7.2.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "@tootallnate/once": "^3.0.1",
    "fast-xml-builder": "^1.1.7",
    "firebase-tools": {
      "ws": "^7.5.11"
    },
    "glob": "^13.0.0",
    "ip-address": "^10.1.1",
    "protobufjs": "^7.6.3",
    "tar": "^7.5.16",
    "tmp": "^0.2.7",
    "uuid": "^14.0.0",
    "js-yaml": "^4.2.0",
    "@opentelemetry/core": "^2.8.0"
  }
}
