{
  "name": "@octogee/scripts",
  "version": "1.0.0",
  "description": "Octogee local tooling scripts",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "provision": "tsx entrypoints/fleet-controller.ts",
    "fleet": "tsx ops/fleet.ts",
    "backfill-gateway-field": "tsx ops/backfill-gateway-field.ts",
    "backfill-gateway-mutable-config": "tsx ops/backfill-gateway-mutable-config.ts",
    "verify:openclaw-candidate": "tsx ops/verify-openclaw-candidate.ts",
    "pretest": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test": "npx vitest run __tests__",
    "pretest:emulator": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:emulator": "node ops/run-emulator-vitest.mjs --only firestore --project octogee-test --firebase-config ../firebase.json --config vitest.emulator.config.ts --env GCLOUD_PROJECT=octogee-test",
    "pretest:emulator:one": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:emulator:one": "node ops/run-emulator-vitest.mjs --only firestore --project octogee-test --firebase-config ../firebase.json --config vitest.emulator.config.ts --env GCLOUD_PROJECT=octogee-test",
    "audit-coverage": "tsx ops/audit-coverage.ts",
    "verify-silent-post": "tsx ops/verify-silent-post.ts",
    "verify:mattermost-capability": "tsx ops/verify-mattermost-capability-artifact.ts",
    "scope": "tsx ops/scope.ts"
  },
  "allowScripts": {
    "node-pty": true,
    "esbuild": true,
    "protobufjs": true,
    "@firebase/util": true,
    "fsevents": true,
    "re2": false
  },
  "dependencies": {
    "@octogee/core": "file:../core",
    "@octogee/shared": "file:../shared",
    "express": "^5.2.1",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "^10.9.0",
    "node-pty": "^1.1.0",
    "stripe": "^22.4.0",
    "tsx": "^4.23.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.14",
    "firebase-tools": "^15.25.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "^2.0.10",
      "hono": "^4.12.34"
    },
    "@protobufjs/utf8": "^1.1.1",
    "@tootallnate/once": "^3.0.1",
    "brace-expansion@<2.0.0": "1.1.18",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.9",
    "fast-xml-builder": "^1.1.7",
    "fast-uri": "^3.1.5",
    "firebase-tools": {
      "ws": "^7.5.11"
    },
    "glob": "^13.0.0",
    "ip-address": "^10.2.1",
    "protobufjs": "^7.6.3",
    "re2": "1.25.2",
    "tar": "^7.5.16",
    "tmp": "^0.2.7",
    "uuid": "^14.0.0",
    "js-yaml": "^4.2.0",
    "@opentelemetry/core": "^2.8.0",
    "postcss": "8.5.25",
    "undici@<7.0.0": "^6.28.0"
  }
}
