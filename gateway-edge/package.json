{
  "name": "@octogee/gateway-edge",
  "version": "1.0.0",
  "description": "Octogee gateway-edge sidecar \u2014 locality-bound HTTP routes (ESM)",
  "type": "module",
  "main": "dist/gateway-edge/src/index.js",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json && npm run verify:no-alias-leakage",
    "build:watch": "tsc --watch",
    "start": "node dist/gateway-edge/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --exclude 'src/**/__tests__/**/*.emulator.spec.ts'",
    "test:watch": "vitest --exclude 'src/**/__tests__/**/*.emulator.spec.ts'",
    "test:emulator": "GCLOUD_PROJECT=octogee-test firebase emulators:exec --only firestore,auth --project=octogee-test 'GCLOUD_PROJECT=octogee-test npx vitest run --config vitest.emulator.config.ts'",
    "test:all": "npm test && npm run test:emulator",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:no-alias-leakage": "! grep -rq --include='*.js' '@shared' dist/ || (echo '\u274c Found un-rewritten @shared/* alias in compiled JS. Fix: ensure tsc-alias is installed and the build script runs `tsc && tsc-alias -p tsconfig.json` (path alias rewriting must run after emit, or Node will fail at runtime with MODULE_NOT_FOUND).' && exit 1)"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1073.0",
    "@google-cloud/kms": "^5.5.1",
    "@google-cloud/secret-manager": "^6.2.0",
    "@octogee/core": "file:../core",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "jszip": "^3.10.1",
    "prom-client": "^15.1.3",
    "resend": "^6.14.0",
    "sharp": "^0.35.2",
    "stripe": "^22.2.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^4.1.9",
    "firebase-tools": "^15.22.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "@tootallnate/once": "^3.0.1",
    "fast-xml-builder": "^1.1.7",
    "firebase-tools": {
      "ws": "^7.5.11"
    },
    "glob": "^13.0.0",
    "ip-address": "^10.1.1",
    "protobufjs": "^7.6.3",
    "tmp": "^0.2.7",
    "uuid": "^14.0.0",
    "js-yaml": "^4.2.0",
    "@opentelemetry/core": "^2.8.0"
  }
}
