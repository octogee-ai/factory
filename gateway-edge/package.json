{
  "name": "@octogee/gateway-edge",
  "version": "1.0.0",
  "description": "Octogee gateway-edge sidecar \u2014 locality-bound HTTP routes (ESM)",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/gateway-edge/src/index.js",
  "scripts": {
    "prebuild": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "build": "tsc && tsc-alias -p tsconfig.json && npm run verify:no-alias-leakage",
    "build:watch": "tsc --watch",
    "start": "node dist/gateway-edge/src/index.js",
    "dev": "OCTOGEE_ALLOW_LOCAL_ORIGINS=true tsx watch src/index.ts",
    "pretest": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test": "vitest run --exclude 'src/**/__tests__/**/*.emulator.spec.ts'",
    "pretest:watch": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:watch": "vitest --exclude 'src/**/__tests__/**/*.emulator.spec.ts'",
    "pretest:emulator": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:emulator": "node ../scripts/ops/run-emulator-vitest.mjs --only firestore,auth --project octogee-test --config vitest.emulator.config.ts --env GCLOUD_PROJECT=octogee-test",
    "pretest:emulator:one": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:emulator:one": "node ../scripts/ops/run-emulator-vitest.mjs --only firestore,auth --project octogee-test --config vitest.emulator.config.ts --env GCLOUD_PROJECT=octogee-test",
    "test:all": "npm test && npm run test:emulator",
    "pretest:coverage": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "typecheck": "tsc --noEmit",
    "verify:no-alias-leakage": "! grep -rq --include='*.js' '@shared' dist/ || (echo '\u274c Found un-rewritten @shared/* alias in compiled JS. Fix: ensure tsc-alias is installed and the build script runs `tsc && tsc-alias -p tsconfig.json` (path alias rewriting must run after emit, or Node will fail at runtime with MODULE_NOT_FOUND).' && exit 1)"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1152.0",
    "@google-cloud/kms": "^6.3.0",
    "@google-cloud/secret-manager": "^7.0.0",
    "@octogee/core": "file:../core",
    "@octogee/shared": "file:../shared",
    "@ricky0123/vad-web": "^0.0.31",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "json5": "^2.2.3",
    "jszip": "^3.10.2",
    "onnxruntime-web": "^1.30.0",
    "prom-client": "^15.1.3",
    "resend": "^6.34.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@octogee/test-helpers": "file:../test-helpers",
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.5",
    "firebase-tools": "^15.34.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "^2.0.10",
      "hono": "^4.13.11"
    },
    "@protobufjs/utf8": "^1.1.1",
    "@tootallnate/once": "^3.0.1",
    "body-parser@>=2.0.0 <3.0.0": "^2.4.0",
    "brace-expansion@<2.0.0": "1.1.21",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
    "fast-xml-builder": "^1.1.7",
    "fast-uri": "^3.1.6",
    "firebase-tools": {
      "ws": "^7.5.11",
      "csv-parse": "^7.0.2"
    },
    "glob": "^13.0.0",
    "ip-address": "^10.2.1",
    "protobufjs": "^7.6.3",
    "qs": "^6.16.0",
    "re2": "1.26.1",
    "tmp": "^0.2.7",
    "uuid": "^14.0.0",
    "js-yaml": "^4.3.1",
    "@opentelemetry/core": "^2.8.0",
    "postcss": "8.5.25",
    "undici@<7.0.0": "^6.28.0",
    "basic-ftp": "^6.2.1"
  }
}
