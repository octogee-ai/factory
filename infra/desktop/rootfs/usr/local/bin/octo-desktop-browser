#!/usr/bin/bash
set -euo pipefail

sandbox_args=()
case "${OCTO_CHROMIUM_NO_SANDBOX-0}" in
  0) ;;
  1) sandbox_args+=(--no-sandbox) ;;
  *) printf '%s\n' 'OCTO_CHROMIUM_NO_SANDBOX must be 0 or 1' >&2; exit 2 ;;
esac

if (( $# == 0 )); then
  set -- "--app=${OCTO_HOME_URL:-http://127.0.0.1:7777/desk}"
fi

export ACCESSIBILITY_ENABLED=1
exec chromium --ozone-platform=wayland --disable-gpu "${sandbox_args[@]}" --no-first-run --password-store=basic \
  --force-renderer-accessibility \
  --user-data-dir="$HOME/.config/octogee-chromium" \
  --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 "$@"
