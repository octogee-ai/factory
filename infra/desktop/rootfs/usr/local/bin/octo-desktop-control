#!/usr/bin/python3
import json
import os
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from threading import Lock

OUTPUT = os.environ.get("OCTO_OUTPUT_NAME", "OCTOGEE")
COMPOSITOR = os.environ.get("OCTO_COMPOSITOR", "hyprland")
ACTION_LOCK = Lock()


def run(argv, timeout=15):
    return subprocess.run(argv, capture_output=True, timeout=timeout)


def hyprctl_json(*args):
    out = run(["hyprctl", "-j", *args])
    if out.returncode != 0:
        raise RuntimeError(out.stderr.decode(errors="replace"))
    return json.loads(out.stdout or b"null")


def windows():
    if COMPOSITOR == "hyprland":
        return hyprctl_json("clients")
    out = run(["wlrctl", "toplevel", "list"])
    if out.returncode != 0:
        raise RuntimeError(out.stderr.decode(errors="replace"))
    result = []
    for line in out.stdout.decode(errors="replace").splitlines():
        app_id, _, title = line.partition(": ")
        result.append({"class": app_id.strip(), "title": title.strip()})
    return result


def monitors():
    if COMPOSITOR == "hyprland":
        return [m.get("name") for m in hyprctl_json("monitors", "all")]
    out = run(["wlr-randr", "--json"])
    if out.returncode != 0:
        raise RuntimeError(out.stderr.decode(errors="replace"))
    return [m.get("name") for m in json.loads(out.stdout or b"[]")]


def resize(width, height):
    if type(width) is not int or type(height) is not int or not (320 <= width <= 3840 and 240 <= height <= 2160):
        raise ValueError("display size must be integers within 320x240 and 3840x2160")
    if COMPOSITOR != "hyprland":
        raise RuntimeError("display resizing requires Hyprland")
    expression = 'hl.monitor({ output = %s, mode = "%dx%d@30", position = "0x0", scale = 1 })' % (json.dumps(OUTPUT), width, height)
    out = run(["hyprctl", "eval", expression])
    if out.returncode != 0:
        raise RuntimeError(out.stderr.decode(errors="replace"))
    for _ in range(20):
        actual = next((m for m in hyprctl_json("monitors", "all") if m.get("name") == OUTPUT), None)
        if actual and actual.get("width") == width and actual.get("height") == height:
            return {"width": width, "height": height}
        time.sleep(0.1)
    raise RuntimeError("compositor did not apply requested display size")


def screenshot_png():
    out = run(["grim", "-o", OUTPUT, "-t", "png", "-"], timeout=30)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.decode(errors="replace"))
    return out.stdout



class Handler(BaseHTTPRequestHandler):
    def _send(self, status, body, content_type="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (self.command, fmt % args))

    def do_POST(self):
        if self.path != "/resize":
            self._send(404, {"error": "not found"})
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            if not 0 < length <= 1024:
                raise ValueError("invalid request size")
            body = json.loads(self.rfile.read(length))
            if not isinstance(body, dict):
                raise ValueError("expected display dimensions")
            with ACTION_LOCK:
                result = resize(body.get("width"), body.get("height"))
            self._send(200, result)
        except ValueError as exc:
            self._send(400, {"error": str(exc)})
        except Exception as exc:
            self._send(500, {"error": str(exc)})

    def do_GET(self):
        try:
            with ACTION_LOCK:
                if self.path == "/health":
                    clients = [c.get("class") for c in windows()]
                    self._send(200, {
                        "ok": True,
                        "compositor": COMPOSITOR,
                        "output": OUTPUT,
                        "monitors": monitors(),
                        "clients": clients,
                    })
                elif self.path == "/screenshot":
                    self._send(200, screenshot_png(), "image/png")
                elif self.path == "/windows":
                    self._send(200, windows())
                else:
                    self._send(404, {"error": "not found"})
        except Exception as exc:  # noqa: BLE001
            self._send(500, {"error": str(exc)})


def main():
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 7777
    bind = os.environ.get("OCTO_BIND", "0.0.0.0")
    server = ThreadingHTTPServer((bind, port), Handler)
    sys.stderr.write("control api on %s:%d for output %s\n" % (bind, port, OUTPUT))
    server.serve_forever()


if __name__ == "__main__":
    main()
