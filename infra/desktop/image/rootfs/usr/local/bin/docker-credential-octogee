#!/usr/bin/env bash
set -euo pipefail

json_string() { local value="${1//\\/\\\\}"; printf '%s' "${value//\"/\\\"}"; }

case "${1:-}" in
  get)
    server="$(cat)"
    if [[ -z "${OCTOGEE_REGISTRY_TOKEN:-}" ]]; then
      echo "docker-credential-octogee: OCTOGEE_REGISTRY_TOKEN is not set for $server" >&2
      exit 1
    fi
    printf '{"ServerURL":"%s","Username":"oauth2accesstoken","Secret":"%s"}\n' "$(json_string "$server")" "$(json_string "$OCTOGEE_REGISTRY_TOKEN")"
    ;;
  store|erase)
    echo "docker-credential-octogee: refuses to ${1} registry credentials; each pull takes its token from OCTOGEE_REGISTRY_TOKEN" >&2
    exit 1
    ;;
  *)
    echo "docker-credential-octogee: unsupported action '${1:-}'" >&2
    exit 1
    ;;
esac
