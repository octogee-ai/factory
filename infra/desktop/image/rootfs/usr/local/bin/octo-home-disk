#!/usr/bin/env bash
set -euo pipefail

DEVICE="${OCTO_HOME_DEVICE:-/dev/disk/by-id/scsi-0Google_PersistentDisk_octogee-home}"
STATE_ROOT="${OCTO_VM_STATE_ROOT:-/srv/octogee}"
USER_HOME="${OCTO_USER_HOME:-/home/octo}"
WAIT_SECONDS="${OCTO_HOME_DEVICE_WAIT_SECONDS:-60}"
DESKTOP_WANTED="${OCTO_DESKTOP_WANTED:-/usr/local/bin/octo-desktop-wanted}"

for _ in $(seq 1 "$WAIT_SECONDS"); do
  [ -e "$DEVICE" ] && break
  sleep 1
done
if [ ! -e "$DEVICE" ]; then
  echo "octo-home-disk: $DEVICE is not attached; the Builder home stays unmounted rather than landing on the boot disk" >&2
  exit 1
fi

set +e
fstype="$(blkid -p -s TYPE -o value "$DEVICE")"
probe=$?
set -e
case "$probe" in
  0)
    if [ "$fstype" != btrfs ]; then
      echo "octo-home-disk: $DEVICE holds $fstype, not btrfs; refusing to mount or format it" >&2
      exit 1
    fi
    ;;
  2)
    echo "octo-home-disk: formatting blank $DEVICE as btrfs"
    mkfs.btrfs -q -L octogee-home "$DEVICE"
    ;;
  *)
    echo "octo-home-disk: blkid could not probe $DEVICE (exit $probe)" >&2
    exit 1
    ;;
esac

home_uuid="$(blkid -s UUID -o value "$DEVICE")"
[ -n "$home_uuid" ] || { echo "octo-home-disk: attached home has no filesystem UUID" >&2; exit 1; }
verify_mount() {
  local target="$1" root="$2" observed
  observed="$(findmnt -n -o UUID,FSTYPE,FSROOT --mountpoint "$target")"
  read -r uuid type fsroot <<< "$observed"
  if [[ "$uuid" != "$home_uuid" || "$type" != btrfs || "$fsroot" != "$root" ]]; then
    echo "octo-home-disk: $target does not match the attached home ($observed)" >&2
    exit 1
  fi
}

install -d -m 0755 "$STATE_ROOT"
mountpoint -q "$STATE_ROOT" || mount -o noatime "$DEVICE" "$STATE_ROOT"
verify_mount "$STATE_ROOT" /
if mountpoint -q "$USER_HOME"; then verify_mount "$USER_HOME" /desktop-home; fi
btrfs filesystem resize max "$STATE_ROOT"

if [ ! -d "$STATE_ROOT/desktop-home" ]; then
  echo "octo-home-disk: seeding $STATE_ROOT/desktop-home from the image's $USER_HOME"
  rm -rf "$STATE_ROOT/desktop-home.seed"
  cp -a "$USER_HOME/." "$STATE_ROOT/desktop-home.seed"
  mv "$STATE_ROOT/desktop-home.seed" "$STATE_ROOT/desktop-home"
fi
if [[ -f "$STATE_ROOT/.octogee-home-layout.json" && ! -f "$STATE_ROOT/.octogee-native-seeded" ]]; then
  if mountpoint -q "$USER_HOME"; then
    echo "octo-home-disk: migrated desktop defaults require the unmounted image home" >&2
    exit 1
  fi
  cp -an "$USER_HOME/." "$STATE_ROOT/desktop-home/"
  printf '1\n' > "$STATE_ROOT/.octogee-native-seeded"
fi
set +e
"$DESKTOP_WANTED" >/dev/null
desktop_wanted=$?
set -e
case "$desktop_wanted" in
  0) ;;
  1)
    if mountpoint -q "$USER_HOME"; then
      echo "octo-home-disk: this X11 computer's $USER_HOME is bound to the home disk; its gateway must be the only user of $STATE_ROOT/desktop-home" >&2
      exit 1
    fi
    echo "octo-home-disk: $DEVICE mounted at $STATE_ROOT; the X11 gateway owns $STATE_ROOT/desktop-home and $USER_HOME stays the boot-disk login home"
    exit 0
    ;;
  *)
    echo "octo-home-disk: cannot tell which desktop this computer runs (octo-desktop-wanted exited $desktop_wanted)" >&2
    exit 1
    ;;
esac
mountpoint -q "$USER_HOME" || mount --bind "$STATE_ROOT/desktop-home" "$USER_HOME"
verify_mount "$USER_HOME" /desktop-home
echo "octo-home-disk: $DEVICE mounted at $STATE_ROOT; $USER_HOME bound to $STATE_ROOT/desktop-home"
