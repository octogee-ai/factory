[Unit]
Description=Octogee computer desktop session (Hyprland, wayvnc, noVNC, control API, Chromium)
After=octo-seatd.service network-online.target user-runtime-dir@1000.service octo-home-disk.service
Wants=octo-seatd.service network-online.target
Requires=user-runtime-dir@1000.service octo-home-disk.service

[Service]
User=octo
Group=octo
Environment=HOME=/home/octo
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=OCTO_COMPOSITOR=hyprland
Environment=OCTO_DISPLAY=drm
Environment=OCTO_RESOLUTION=1440x900
Environment=OCTO_REFRESH=60
Environment=OCTO_BIND=127.0.0.1
Environment=OCTO_HOME_URL=https://octogee.com
ExecStart=/usr/local/bin/octo-desktop-session
ExecStop=/usr/local/bin/octo-desktop-stop
StandardOutput=journal+console
StandardError=journal
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
