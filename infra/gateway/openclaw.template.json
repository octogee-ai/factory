{
  "meta": {
    "lastTouchedVersion": "2026.4.14",
    "lastTouchedAt": "2026-04-17T01:04:39.966Z"
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "auth": {
    "profiles": {
      "anthropic:default": {
        "provider": "anthropic",
        "mode": "api_key"
      },
      "openai:default": {
        "provider": "openai",
        "mode": "api_key"
      }
    }
  },
  "secrets": {
    "providers": {
      "gcp-secret-manager": {
        "source": "exec",
        "command": "/usr/local/bin/node",
        "args": [
          "/octogee/scripts/secret-resolver.mjs"
        ],
        "passEnv": [
          "FLEET_BROKER_URL",
          "OCTOGEE_API_URL",
          "OCTOGEE_API_SA_TOKEN_PATH",
          "INTERNAL_SERVICE_KEY",
          "OPENCLAW_AGENTS_DIR",
          "HOME"
        ],
        "jsonOnly": true,
        "timeoutMs": 5000,
        "allowInsecurePath": true
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-sonnet-4-6"
      },
      "models": {
        "anthropic/claude-sonnet-4-6": {
          "alias": "sonnet",
          "params": {
            "cacheRetention": "short"
          }
        },
        "anthropic/claude-haiku-4-5": {
          "alias": "haiku",
          "params": {
            "cacheRetention": "short"
          }
        }
      },
      "workspace": "/home/node/.openclaw/workspace",
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h"
      },
      "compaction": {
        "mode": "safeguard"
      },
      "heartbeat": {
        "every": "30m"
      },
      "maxConcurrent": 8,
      "subagents": {
        "maxConcurrent": 8,
        "model": "anthropic/claude-sonnet-4-6",
        "runTimeoutSeconds": 900
      }
    },
    "list": [
      {
        "id": "${OPERATOR_AGENT_ID}",
        "name": "Mac (${OPERATOR_AGENT_SLUG})",
        "workspace": "/home/node/.openclaw/workspace/ops",
        "agentDir": "/home/node/.openclaw/agents/${OPERATOR_AGENT_ID}/agent",
        "model": "anthropic/claude-sonnet-4-6",
        "heartbeat": {
          "every": "30m"
        },
        "identity": {
          "name": "Mac",
          "emoji": "🔧"
        }
      }
    ]
  },
  "tools": {
    "elevated": {
      "enabled": false
    },
    "deny": ["exec", "process"],
    "exec": {
      "mode": "deny"
    },
    "subagents": {
      "tools": {
        "deny": ["exec", "process"]
      }
    }
  },
  "bindings": [],
  "messages": {
    "ackReactionScope": "group-mentions",
    "groupChat": {
      "visibleReplies": "automatic"
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "channels": {
    "mattermost": {
      "enabled": true,
      "baseUrl": "${MM_URL}",
      "chatmode": "onmessage",
      "requireMention": false,
      "network": {
        "dangerouslyAllowPrivateNetwork": true
      },
      "interactions": {
        "callbackBaseUrl": "${MM_INTERACTIONS_CALLBACK_BASE_URL}",
        "allowedSourceIps": ["${MM_INTERACTIONS_ALLOWED_SOURCE_IPS}"]
      },
      "commands": {
        "native": false
      },
      "accounts": {
        "default": {
          "botToken": "${MM_BOT_TOKEN}",
          "commands": {
            "native": false
          }
        }
      },
      "defaultAccount": "default"
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    }
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "mattermost",
      "anthropic",
      "memory-core",
      "octogee-mattermost-tools",
      "octogee-workspace-tools",
      "octogee-router",
      "openai"
    ],
    "entries": {
      "mattermost": {
        "enabled": true
      },
      "anthropic": {
        "enabled": true
      },
      "codex": {
        "enabled": false
      },
      "octogee-mattermost-tools": {
        "enabled": true,
        "config": {
          "mattermostUrl": "${MM_URL}",
          "siteUrl": "${MM_SITE_URL}",
          "patCacheTtlSeconds": 300
        }
      },
      "octogee-workspace-tools": {
        "enabled": true,
        "config": {}
      },
      "octogee-router": {
        "enabled": true,
        "config": {},
        "hooks": {
          "allowConversationAccess": true
        }
      }
    }
  }
}
