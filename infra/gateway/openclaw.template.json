{
  "meta": {
    "lastTouchedVersion": "2026.3.8",
    "lastTouchedAt": "2026-03-12T00:00:00.000Z"
  },
  "auth": {
    "profiles": {
      "anthropic:default": { "provider": "anthropic", "mode": "api_key" }
    }
  },
  "agents": {
    "defaults": {
      "model": { "primary": "anthropic/claude-sonnet-4-6" },
      "models": {
        "anthropic/claude-sonnet-4-6": { "alias": "sonnet", "params": { "cacheRetention": "short" } }
      },
      "workspace": "/home/node/.openclaw/workspace",
      "contextPruning": { "mode": "cache-ttl", "ttl": "1h" },
      "compaction": { "mode": "safeguard" },
      "heartbeat": { "every": "30m" },
      "maxConcurrent": 8,
      "subagents": {
        "maxConcurrent": 8,
        "model": "anthropic/claude-sonnet-4-6",
        "runTimeoutSeconds": 900
      }
    },
    "list": [
      {
        "id": "mac",
        "name": "Mac (Octogee Ops)",
        "workspace": "/home/node/.openclaw/workspace/ops",
        "agentDir": "/home/node/.openclaw/agents/mac/agent",
        "model": "anthropic/claude-sonnet-4-6",
        "heartbeat": { "every": "30m" },
        "identity": { "name": "Mac", "emoji": "🔧" }
      }
    ]
  },
  "tools": {
    "elevated": { "enabled": false },
    "subagents": { "tools": { "deny": [] } }
  },
  "bindings": [],
  "messages": { "ackReactionScope": "group-mentions" },
  "commands": { "native": "auto", "nativeSkills": "auto", "restart": true, "ownerDisplay": "raw" },
  "session": { "dmScope": "per-channel-peer" },
  "channels": {
    "mattermost": {
      "enabled": true,
      "botToken": "${MM_BOT_TOKEN}",
      "baseUrl": "${MM_URL}",
      "chatmode": "onmessage",
      "requireMention": false,
      "dmPolicy": "disabled",
      "groupPolicy": "open",
      "allowFrom": ["*"],
      "threading": "off"
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${GATEWAY_TOKEN}",
      "rateLimit": { "maxAttempts": 10, "windowMs": 60000, "lockoutMs": 300000 }
    }
  },
  "plugins": {
    "enabled": true,
    "allow": ["mattermost", "octogee-router"],
    "entries": {
      "octogee-router": {
        "enabled": true,
        "config": {
          "enforcement": "soft",
          "advisorySlugs": [],
          "enforcementOverrides": {}
        }
      }
    }
  }
}
