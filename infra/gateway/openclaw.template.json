{
  "meta": {
    "lastTouchedVersion": "2026.4.14"
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "auth": {
    "profiles": {
      "anthropic:default": {
        "provider": "anthropic",
        "mode": "api_key"
      },
      "openai:default": {
        "provider": "openai",
        "mode": "api_key"
      }
    }
  },
  "secrets": {
    "providers": {
      "gcp-secret-manager": {
        "source": "exec",
        "command": "/octogee/scripts/secret-resolver.mjs",
        "passEnv": [
          "FLEET_BROKER_URL",
          "OCTOGEE_API_URL",
          "OCTOGEE_API_SA_TOKEN_PATH",
          "INTERNAL_SERVICE_KEY",
          "OPENCLAW_AGENTS_DIR",
          "HOME"
        ],
        "jsonOnly": true,
        "timeoutMs": 5000
      },
      "octogee-mattermost": {
        "source": "file",
        "path": "/home/node/.openclaw/secrets/mattermost-accounts.json",
        "mode": "json"
      }
    }
  },
  "agents": {
    "defaults": {
      "models": {
        "platform-openrouter/deepseek/deepseek-v4-pro": {
          "alias": "deepseek"
        },
        "platform-openrouter/z-ai/glm-5.2": {
          "alias": "glm",
          "params": {
            "thinking": "xhigh"
          }
        },
        "anthropic/claude-sonnet-4-6": {
          "alias": "sonnet",
          "params": {
            "cacheRetention": "short"
          }
        },
        "anthropic/claude-haiku-4-5": {
          "alias": "haiku",
          "params": {
            "cacheRetention": "short"
          }
        }
      },
      "workspace": "/home/node/.openclaw/workspace",
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h"
      },
      "compaction": {
        "mode": "safeguard"
      },
      "heartbeat": {
        "every": "30m"
      },
      "maxConcurrent": 8,
      "subagents": {
        "maxConcurrent": 8,
        "runTimeoutSeconds": 900
      }
    },
    "list": []
  },
  "tools": {
    "profile": "coding",
    "elevated": {
      "enabled": false
    },
    "deny": ["exec", "process", "subagents", "sessions_spawn"],
    "alsoAllow": [
      "preview_start",
      "preview_stop",
      "preview_list",
      "octogee_publish",
      "octogee_publish_draft",
      "octogee_project_create",
      "octogee_project_commit",
      "octogee_project_list",
      "octogee_project_set_recipe",
      "workspace_commit",
      "brave_search",
      "tavily_search",
      "tavily_extract",
      "octogee_chat_search",
      "octogee_chat_history",
      "octogee_chat_set_identity",
      "octogee_status",
      "octogee_ask_ops",
      "octogee_google_calendar_list",
      "octogee_google_calendar_read",
      "octogee_google_calendar_write",
      "octogee_google_gmail_read",
      "octogee_google_gmail_write",
      "octogee_google_drive_read",
      "octogee_google_docs_read",
      "octogee_google_docs_write",
      "octogee_google_contacts_read",
      "octogee_google_tasks_read",
      "octogee_google_tasks_write",
      "octogee_google_sheets_read",
      "octogee_google_sheets_write",
      "octogee_obsidian_read",
      "octogee_obsidian_write"
    ],
    "web": {
      "search": {
        "provider": "parallel-free"
      }
    },
    "exec": {
      "mode": "deny"
    },
    "sessions": {
      "visibility": "agent"
    },
    "subagents": {
      "tools": {
        "deny": ["exec", "process"]
      }
    }
  },
  "bindings": [],
  "messages": {
    "ackReactionScope": "group-mentions",
    "groupChat": {
      "visibleReplies": "automatic"
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "channels": {
    "mattermost": {
      "enabled": true,
      "baseUrl": "${MM_URL}",
      "chatmode": "onmessage",
      "requireMention": false,
      "network": {
        "dangerouslyAllowPrivateNetwork": true
      },
      "interactions": {
        "callbackBaseUrl": "${MM_INTERACTIONS_CALLBACK_BASE_URL}",
        "allowedSourceIps": ["${MM_INTERACTIONS_ALLOWED_SOURCE_IPS}"]
      },
      "commands": {
        "native": false
      },
      "accounts": {}
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    }
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "mattermost",
      "anthropic",
      "memory-core",
      "octogee-chat-tools",
      "octogee-connector-tools",
      "octogee-access-tools",
      "octogee-preview-tools",
      "octogee-project-tools",
      "octogee-status-tools",
      "octogee-ops-tools",
      "octogee-web-tools",
      "octogee-workspace-tools",
      "octogee-publish-tools",
      "parallel",
      "openai"
    ],
    "entries": {
      "mattermost": {
        "enabled": true
      },
      "anthropic": {
        "enabled": true
      },
      "codex": {
        "enabled": false
      },
      "octogee-chat-tools": {
        "enabled": true,
        "hooks": {
          "allowPromptInjection": true,
          "timeouts": {
            "before_prompt_build": 3000
          }
        },
        "config": {
          "siteUrl": "${MM_SITE_URL}",
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}",
          "customersRoot": "${CUSTOMERS_DIR}"
        }
      },
      "octogee-connector-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}"
        }
      },
      "octogee-access-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}"
        }
      },
      "octogee-preview-tools": {
        "enabled": true,
        "config": {}
      },
      "octogee-project-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}"
        }
      },
      "octogee-status-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}",
          "gatewayClass": "${GATEWAY_CLASS}"
        }
      },
      "octogee-ops-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}"
        }
      },
      "octogee-web-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "gatewayId": "${GATEWAY_ID}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}"
        }
      },
      "octogee-workspace-tools": {
        "enabled": true,
        "config": {}
      },
      "octogee-publish-tools": {
        "enabled": true,
        "config": {}
      },
      "parallel": {
        "enabled": true
      }
    }
  }
}
