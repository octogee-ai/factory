# Octogee Gateway — Environment Variables
# Copy this to .env and fill in the values.
# .env is gitignored. Never commit it.

# Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-...

# Gateway auth token (auto-generated by setup.sh if blank — saved back here)
OPENCLAW_GATEWAY_TOKEN=

# ── Firebase credentials ─────────────────────────────────────────────────────
# The provisioner needs a Firebase service account key to watch Firestore.
#
# LOCAL DEV:
#   Download a service account key from Firebase Console → Project Settings → Service Accounts.
#   Save it to a safe location and reference via GOOGLE_APPLICATION_CREDENTIALS.
#
# GCP (Workload Identity):
#   Grant the GCE VM's service account the "Firebase Admin SDK Administrator" role.
#   No key file needed — provisioner uses Application Default Credentials automatically.
#
# OVERRIDE (optional):
# GOOGLE_APPLICATION_CREDENTIALS=/home/node/.openclaw/secrets/octogee-sa-key.json

# ── Docker image names ────────────────────────────────────────────────────────
OCTOGEE_GATEWAY_IMAGE=octogee-gateway:local
OPENCLAW_BASE_IMAGE=openclaw:local

# ── Gateway port ─────────────────────────────────────────────────────────────
# Default: 18791 — avoids conflict with BenderEcho on 18789
GATEWAY_PORT=18791

# ── Data directory ────────────────────────────────────────────────────────────
# All gateway data lives here: openclaw.json, agent workspaces, customer dirs, SA key.
# Bind-mounted into the container at /home/node/.openclaw
# OCTOGEE_DATA_DIR=/path/to/octogee-gateway

# ── Usage tracking & gateway identity ────────────────────────────────────────
# Identifier for this gateway instance, written to Firestore usage_logs.
# GATEWAY_ID=local
