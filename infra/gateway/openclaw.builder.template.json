{
  "meta": {
    "lastTouchedVersion": "2026.4.14"
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "auth": {
    "profiles": {
      "anthropic:default": {
        "provider": "anthropic",
        "mode": "api_key"
      },
      "openai:default": {
        "provider": "openai",
        "mode": "api_key"
      }
    }
  },
  "secrets": {
    "providers": {
      "gcp-secret-manager": {
        "source": "exec",
        "command": "/octogee/scripts/secret-resolver.mjs",
        "passEnv": [
          "FLEET_BROKER_URL",
          "OCTOGEE_API_URL",
          "OCTOGEE_API_SA_TOKEN_PATH",
          "INTERNAL_SERVICE_KEY",
          "OPENCLAW_AGENTS_DIR",
          "HOME"
        ],
        "jsonOnly": true,
        "timeoutMs": 45000
      },
      "octogee-mattermost": {
        "source": "file",
        "path": "/home/node/.openclaw/secrets/mattermost-accounts.json",
        "mode": "json"
      }
    }
  },
  "agents": {
    "defaults": {
      "models": {
        "platform-openrouter/deepseek/deepseek-v4-pro": {
          "alias": "deepseek"
        },
        "platform-openrouter/z-ai/glm-5.2": {
          "alias": "glm",
          "params": {
            "thinking": "xhigh"
          }
        },
        "anthropic/claude-sonnet-4-6": {
          "alias": "sonnet",
          "params": {
            "cacheRetention": "short"
          }
        },
        "anthropic/claude-haiku-4-5": {
          "alias": "haiku",
          "params": {
            "cacheRetention": "short"
          }
        }
      },
      "verboseDefault": "on",
      "toolProgressDetail": "raw",
      "workspace": "/home/node/.openclaw/workspace",
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h"
      },
      "compaction": {
        "mode": "safeguard"
      },
      "heartbeat": {
        "every": "30m"
      },
      "maxConcurrent": 8,
      "subagents": {
        "maxConcurrent": 8,
        "runTimeoutSeconds": 900
      }
    },
    "entries": {}
  },
  "browser": {
    "enabled": false,
    "defaultProfile": "openclaw",
    "headless": true,
    "noSandbox": true,
    "evaluateEnabled": true,
    "executablePath": "/usr/bin/chromium"
  },
  "tools": {
    "profile": "coding",
    "alsoAllow": [
      "message",
      "octogee_project_create",
      "octogee_project_commit",
      "octogee_project_list",
      "octogee_project_set_recipe",
      "octogee_project_capability",
      "octogee_project_build",
      "octogee_project_test",
      "octogee_project_preview",
      "octogee_project_run_status",
      "octogee_project_publish",
      "octogee_board_list",
      "octogee_board_card_read",
      "octogee_board_card_create",
      "octogee_board_card_update",
      "octogee_board_card_move",
      "octogee_board_card_comment",
      "workspace_commit",
      "brave_search",
      "tavily_search",
      "tavily_extract",
      "octogee_chat_search",
      "octogee_chat_history",
      "octogee_chat_set_identity",
      "octogee_status",
      "octogee_ask_ops",
      "octogee_google_calendar_events",
      "octogee_google_calendar_create",
      "octogee_google_calendar_create_approved",
      "octogee_google_calendar_update",
      "octogee_google_calendar_update_approved",
      "octogee_google_calendar_delete",
      "octogee_google_calendar_delete_approved",
      "octogee_google_gmail_search",
      "octogee_google_gmail_get",
      "octogee_google_gmail_triage",
      "octogee_google_gmail_triage_approved",
      "octogee_google_gmail_draft_create",
      "octogee_google_gmail_draft_create_approved",
      "octogee_google_gmail_draft_send",
      "octogee_google_gmail_draft_send_approved",
      "octogee_google_drive_read",
      "octogee_google_docs_read",
      "octogee_google_docs_write",
      "octogee_google_contacts_read",
      "octogee_google_tasks_lists",
      "octogee_google_tasks_list",
      "octogee_google_tasks_add",
      "octogee_google_tasks_add_approved",
      "octogee_google_tasks_update",
      "octogee_google_tasks_update_approved",
      "octogee_google_sheets_read",
      "octogee_google_sheets_write",
      "octogee_obsidian_read",
      "octogee_obsidian_write",
      "browser"
    ],
    "web": {
      "search": {
        "provider": "parallel-free"
      }
    }
  },
  "bindings": [],
  "messages": {
    "ackReactionScope": "group-mentions",
    "groupChat": {
      "visibleReplies": "automatic"
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "channels": {
    "mattermost": {
      "enabled": true,
      "baseUrl": "${MM_URL}",
      "chatmode": "onmessage",
      "requireMention": false,
      "replyToMode": "all",
      "replyToModeByChatType": {
        "direct": "all"
      },
      "threadSessionScope": "channel",
      "actions": { "reactions": true },
      "streaming": {
        "mode": "block",
        "chunkMode": "newline",
        "block": { "enabled": true },
        "preview": {
          "toolProgress": true,
          "commandText": "raw"
        }
      },
      "network": {
        "dangerouslyAllowPrivateNetwork": true
      },
      "interactions": {
        "callbackBaseUrl": "${MM_INTERACTIONS_CALLBACK_BASE_URL}",
        "allowedSourceIps": [
          "${MM_INTERACTIONS_ALLOWED_SOURCE_IPS}"
        ]
      },
      "commands": {
        "native": false
      },
      "accounts": {}
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "terminal": {
      "enabled": true
    },
    "auth": {
      "mode": "token",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    }
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "mattermost",
      "anthropic",
      "memory-core",
      "octogee-chat-tools",
      "octogee-connector-tools",
      "octogee-access-tools",
      "octogee-project-tools",
      "octogee-board-tools",
      "octogee-status-tools",
      "octogee-ops-tools",
      "octogee-web-tools",
      "octogee-workspace-tools",
      "octogee-activity-tools",
      "parallel",
      "openai",
      "browser"
    ],
    "entries": {
      "mattermost": {
        "enabled": true
      },
      "anthropic": {
        "enabled": true
      },
      "browser": {
        "enabled": false
      },
      "octogee-chat-tools": {
        "enabled": true,
        "hooks": {
          "allowPromptInjection": true,
          "allowConversationAccess": true,
          "timeouts": {
            "before_dispatch": 3000,
            "before_prompt_build": 3000,
            "before_agent_run": 3000
          }
        },
        "config": {
          "siteUrl": "${MM_SITE_URL}",
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}",
          "customersRoot": "${CUSTOMERS_DIR}"
        }
      },
      "octogee-connector-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}"
        }
      },
      "octogee-access-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}"
        }
      },
      "octogee-project-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}"
        }
      },
      "octogee-board-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}"
        }
      },
      "octogee-status-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}",
          "gatewayClass": "${GATEWAY_CLASS}"
        }
      },
      "octogee-ops-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}"
        }
      },
      "octogee-web-tools": {
        "enabled": true,
        "config": {
          "brokerUrl": "${FLEET_BROKER_URL}",
          "gatewayId": "${GATEWAY_ID}",
          "tokenPath": "${OCTOGEE_API_SA_TOKEN_PATH}"
        }
      },
      "octogee-workspace-tools": {
        "enabled": true,
        "config": {}
      },
      "octogee-activity-tools": {
        "enabled": true,
        "config": {
          "activityEnabled": true,
          "heartbeatMs": 5000
        }
      },
      "parallel": {
        "enabled": true
      }
    }
  }
}
