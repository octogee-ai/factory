# ─────────────────────────────────────────────────────────────────────────────
# octogee-gateway-base — OpenClaw runtime + all heavy/stable deps
#
# Rebuild this ONLY when upgrading OpenClaw or changing system packages:
#   gcloud builds submit --config cloudbuild-base.yaml \
#     --substitutions=_OPENCLAW_VERSION=2026.4.5 \
#     --project=octogee
#
# What lives here (changes rarely → cached across gateway builds):
#   - OpenClaw npm install
#   - All apt packages (curl, jq, python3, git, ripgrep, ffmpeg, gh, etc.)
#   - @huggingface/transformers (1.2GB — heaviest dep, almost never changes)
#   - octogee-router npm install (node_modules for the classifier extension)
# ─────────────────────────────────────────────────────────────────────────────
# Node 24 matches OpenClaw upstream's publishing + CI target image
# (node:24-bookworm-slim, per their Dockerfile). OpenClaw 2026.4.20's
# `engines.node` declares `>=22.14.0` as the hard floor, but the CI
# matrix runs primarily on 24.x with only partial 22.18 compat. Staying
# in lockstep with their ship target avoids "works on their CI, not on
# our pod" surprises and keeps us on the current LTS line. Unrelated
# services (`gateway-edge` on GKE, `functions` on Firebase) stay on
# Node 22 — they're separate deploy surfaces with their own runtime
# constraints (Firebase Functions Node 24 support lags the runtime).
FROM node:24-bookworm-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ── All system packages in one layer ────────────────────────────────────────
# Combining apt runs avoids duplicate update overhead and saves ~30s per build.
# "Storage is cheap" — ship everything the agent needs to be productive.
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Runtime essentials
    curl jq python3 python3-pip python3-venv \
    sqlite3 xxd rsync \
    ca-certificates openssh-client \
    # Developer experience (available in running pod). The terminal
    # multiplexer that backs BuilderShell PTY sessions is operator-only
    # (see Dockerfile.operator) — never on the shared cattle base.
    bash-completion git vim less \
    # Code search & analysis
    ripgrep tree cloc \
    # Build tools
    make build-essential \
    # Archive & file utilities
    wget unzip zip file bc \
    # Media processing
    ffmpeg imagemagick \
    # Document conversion
    pandoc \
    # Debugging & diagnostics
    htop strace dnsutils net-tools \
    # Fuzzy finder
    fzf \
    && rm -rf /var/lib/apt/lists/*

# ── OpenClaw from private fork tarball ──────────────────────────────────────
# See infra/gateway/openclaw-tarball/README.md for what's patched and why.
# Cloud Build stages the pinned tarball from gs://octogee-openclaw-fork/ into
# this path before the docker build runs. Local docker builds need to
# `gcloud storage cp` the same object manually (see the README).
# When our patches land upstream, swap back to `npm install -g openclaw@${OPENCLAW_VERSION}`.
ARG OPENCLAW_VERSION=latest
COPY infra/gateway/openclaw-tarball/openclaw-fork.tgz /tmp/openclaw-fork.tgz
RUN npm install -g /tmp/openclaw-fork.tgz && openclaw --version && rm /tmp/openclaw-fork.tgz

# ── GitHub CLI ───────────────────────────────────────────────────────────────
# Not in Debian repos — installed from GitHub's own apt source.
# Used heavily by the github skill for PRs, issues, CI logs, and code review.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg 2>/dev/null \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# ── ACP coding agents (Claude Code + Codex) ──────────────────────────────────
# Pre-installed so they're available for ACP runtime sessions without
# per-boot npm install delays or network dependency.
# Refresh stamp: bump this to force a standard-base refresh of unpinned
# ACP CLIs without adding new packages to cattle gateways.
ARG ACP_TOOLCHAIN_REFRESH=2026-05-28
RUN echo "ACP toolchain refresh=${ACP_TOOLCHAIN_REFRESH}" \
    && npm install -g @anthropic-ai/claude-code @openai/codex 2>&1 | tail -50

# ── Python essentials ────────────────────────────────────────────────────────
# Common packages for data work, scraping, and config parsing.
RUN pip3 install --break-system-packages \
    pyyaml beautifulsoup4 pandas matplotlib

# ── Non-root user ────────────────────────────────────────────────────────────
RUN groupadd -r node 2>/dev/null || true && \
    useradd -r -g node -d /home/node -m node 2>/dev/null || true

ENV HOME=/home/node

# ── Heavy extension deps — extracted from GCS-cached tarball ────────────────
# octogee-router needs @huggingface/transformers (~1.2GB) for the NN
# classifier. We don't `npm install` here — the resolved node_modules tree
# is packed once per lockfile by `scripts/pack-router-deps.sh` and stored
# at gs://octogee-openclaw-fork/router-deps-<sha8>.tgz, keyed by
# sha256(package-lock.json)[:8]. The fetch-router-deps Cloud Build step
# stages it into the build context as node_modules.tgz before this layer
# runs. Eliminates ~177 npm-registry fetches + the onnxruntime-node native
# binary download per base build → no upstream rate-limit exposure on the
# heaviest dep tree. Cache miss = build fails fast (no implicit npm
# install fallback); operator runs the pack script to populate.
# Entrypoint symlinks /octogee/extensions/octogee-router/node_modules → here.
COPY infra/gateway/extensions/octogee-router/package.json \
     infra/gateway/extensions/octogee-router/package-lock.json \
     /opt/octogee-router-deps/
COPY infra/gateway/extensions/octogee-router/node_modules.tgz /tmp/router-deps.tgz
RUN tar -xzf /tmp/router-deps.tgz -C /opt/octogee-router-deps \
    && rm /tmp/router-deps.tgz \
    && test -d /opt/octogee-router-deps/node_modules/@huggingface/transformers \
    && chown -R node:node /opt/octogee-router-deps

# ── Pre-bake classifier ONNX model into image ──────────────────────────────
# octogee-router's classifier needs Xenova/all-MiniLM-L6-v2 (~90MB fp32 ONNX)
# at runtime. Downloading at gateway boot from the HF CDN is unreliable:
#   - Partial writes corrupt the EmptyDir cache (poisons every subsequent boot)
#   - CDN hangs stall classifier init for 70+ seconds
#   - Plugin hot-reloads retrigger the same fetch, freezing the event loop
# Baking the model into the image makes classifier init fully offline.
# If the download or warm-up inference fails, the base image build fails loud.
RUN mkdir -p /opt/octogee-router-models && chown -R node:node /opt/octogee-router-models
COPY --chown=node:node infra/gateway/extensions/octogee-router/prebake-model.mjs \
     /opt/octogee-router-deps/prebake-model.mjs
USER node
RUN cd /opt/octogee-router-deps && node prebake-model.mjs
USER root
RUN rm /opt/octogee-router-deps/prebake-model.mjs \
    && ls -la /opt/octogee-router-models/Xenova/all-MiniLM-L6-v2/onnx/

# ── OpenClaw Mattermost plugin ───────────────────────────────────────────────
# No build-time install. `@openclaw/mattermost` ships as a *bundled*
# extension in the OpenClaw dist tree (dist/extensions/mattermost/index.js)
# — that compiled bundle is what serves the channel at runtime. The only
# registry-published package (@openclaw/mattermost@2026.2.21) is
# TypeScript-source-only, which the OC 5.x plugin loader rejects
# ("requires compiled runtime output"). The old `openclaw plugins install
# @openclaw/mattermost | tail` line had been failing silently for months
# (sh has no pipefail → tail greened the layer) with zero runtime impact,
# proving the bundled extension is sufficient. Removed once #979 hardened
# plugin installs to exit 1 and surfaced the long-dead failure. Upstream
# #82425 ("repair source-only official plugin installs") is the broader
# fix landing in 5.16+.

# ── OpenClaw Codex plugin ────────────────────────────────────────────────────
# Registers the `codex` agent harness for BYO-subscription (ChatGPT OAuth)
# coaches running openai/gpt-5.5 via codex. `openclaw plugins install`
# writes under $HOME/.openclaw/npm — but /home/node/.openclaw is an emptyDir
# at runtime (no PVC) that shadows the image copy on every boot. So install
# at build, then STAGE the tree to /opt/openclaw-codex-deps (non-shadowed);
# entrypoint.sh restores it into the emptyDir at boot — the same
# stage→runtime pattern as /opt/octogee-router-deps. Fail-loud on both the
# install and the staging (no `| tail`: sh has no pipefail).
#
# The package's location WITHIN ~/.openclaw/npm is an upstream impl detail
# that moves between releases: ≤5.27 placed it flat at
# `npm/node_modules/@openclaw/codex`; the 5.28 plugin-subsystem refactor
# moved it to a per-plugin project dir
# `npm/projects/openclaw-codex-<hash>/node_modules/@openclaw/codex`. We stage
# the WHOLE `npm` tree (so whatever layout comes along) and assert presence
# with a layout-agnostic find — robust to the next reshuffle. Loading at
# runtime is driven by openclaw.json (plugins.entries.codex.enabled) resolving
# the package from the managed npm root, NOT by the plugins/installs.json
# cache, so only the npm tree needs to survive to the emptyDir.
RUN openclaw plugins install @openclaw/codex > /tmp/oc-plugin.log 2>&1 \
      || { echo "FATAL: @openclaw/codex install failed"; tail -n 20 /tmp/oc-plugin.log; exit 1; }; \
    tail -n 3 /tmp/oc-plugin.log; rm -f /tmp/oc-plugin.log; \
    mkdir -p /opt/openclaw-codex-deps \
      && cp -a /home/node/.openclaw/npm /opt/openclaw-codex-deps/npm \
      && chown -R node:node /opt/openclaw-codex-deps \
      && find /opt/openclaw-codex-deps/npm -type d -path '*/node_modules/@openclaw/codex' 2>/dev/null | grep -q . \
      || { echo "FATAL: @openclaw/codex missing from staged /opt tree"; exit 1; }

# ── npm cache ownership (prevent EACCES in agent exec calls) ─────────────────
RUN mkdir -p /home/node/.npm && chown -R node:node /home/node/.npm
