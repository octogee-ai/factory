FROM node:24-bookworm-slim AS gateway-core-system

ARG NPM_VERSION=12.0.2

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git jq openssh-client rsync tar \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global npm@${NPM_VERSION} --ignore-scripts --no-audit --no-fund \
    && npm_root="$(npm root --global)" \
    && npm install --global brace-expansion@5.0.9 --ignore-scripts --no-audit --no-fund \
    && rm -rf "$npm_root/npm/node_modules/brace-expansion" \
    && mv "$npm_root/brace-expansion" "$npm_root/npm/node_modules/brace-expansion" \
    && npm cache clean --force \
    && install -d -o node -g node /home/node/.npm

ENV HOME=/home/node

FROM gateway-core-system AS gateway-system

ARG FD_VERSION=10.5.0
ARG CLAUDE_CODE_VERSION=2.1.251
ARG CODEX_VERSION=0.151.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv sqlite3 xxd \
    bash-completion vim less ripgrep tree cloc \
    make build-essential wget unzip zip file bc \
    ffmpeg imagemagick chromium fonts-liberation fonts-noto-color-emoji \
    pandoc htop strace dnsutils net-tools fzf \
    && case "$(dpkg --print-architecture)" in \
      amd64) FD_SHA256=1fca9f8fb221f26fe37b425db4935dc8180099bdecfd8e031538bfc9396e95f8 ;; \
      arm64) FD_SHA256=a3128d8e206dd646a27f4637ca081f311df2d6f21cd87bbead7fc92cc0952192 ;; \
      *) echo "Unsupported fd architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/sharkdp/fd/releases/download/v${FD_VERSION}/fd_${FD_VERSION}_$(dpkg --print-architecture).deb" -o /tmp/fd.deb \
    && echo "${FD_SHA256}  /tmp/fd.deb" | sha256sum -c - \
    && dpkg -i /tmp/fd.deb \
    && rm /tmp/fd.deb \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg 2>/dev/null \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages --no-cache-dir \
    pyyaml beautifulsoup4 pandas matplotlib

RUN npm install --global --ignore-scripts --no-audit --no-fund \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
      "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force \
    && test "$(node -p "require('$(npm root -g)/@anthropic-ai/claude-code/package.json').version")" = "$CLAUDE_CODE_VERSION" \
    && test "$(node -p "require('$(npm root -g)/@openai/codex/package.json').version")" = "$CODEX_VERSION"

FROM gateway-core-system AS openclaw-installer

COPY infra/gateway/openclaw-tarball/openclaw-fork.tgz /tmp/openclaw-fork.tgz
RUN set -e; \
    npm install -g /tmp/openclaw-fork.tgz; \
    OPENCLAW_ROOT="$(npm root -g)/openclaw"; \
    OPENCLAW_CORE_VERSION="$(node -e 'const pkg = require(process.argv[1]); if (pkg.name !== "openclaw") process.exit(1); process.stdout.write(pkg.version);' "$OPENCLAW_ROOT/package.json")"; \
    test -n "$OPENCLAW_CORE_VERSION"; \
    openclaw --version; \
    grep -RIl -F '"config.changed"' "$OPENCLAW_ROOT/dist" >/dev/null \
      || { echo "FATAL: installed OpenClaw runtime does not publish config.changed"; exit 1; }; \
    rm -f /tmp/openclaw-fork.tgz; \
    npm cache clean --force

FROM openclaw-installer AS openclaw-core-plugin-installer

COPY infra/gateway/openclaw-tarball/openclaw-mattermost-fork.tgz /tmp/openclaw-mattermost-fork.tgz
RUN set -e; \
    OPENCLAW_ROOT="$(npm root -g)/openclaw"; \
    OPENCLAW_CORE_VERSION="$(node -e 'const pkg = require(process.argv[1]); process.stdout.write(pkg.version);' "$OPENCLAW_ROOT/package.json")"; \
    OC_VENDOR="$OPENCLAW_ROOT/vendor"; \
    if [ -f "$OC_VENDOR/openclaw-parallel-plugin.tgz" ]; then \
      openclaw plugins install "npm-pack:$OC_VENDOR/openclaw-parallel-plugin.tgz" --force --accept-capabilities > /tmp/oc-plugin.log 2>&1; \
    else \
      openclaw plugins install "@openclaw/parallel-plugin@${OPENCLAW_CORE_VERSION}" --accept-capabilities > /tmp/oc-plugin.log 2>&1; \
    fi \
      || { echo "FATAL: @openclaw/parallel-plugin install failed"; tail -n 20 /tmp/oc-plugin.log; exit 1; }; \
    MATTERMOST_STAGE="$(mktemp -d)"; \
    tar -xzf /tmp/openclaw-mattermost-fork.tgz -C "$MATTERMOST_STAGE"; \
    MATTERMOST_PACKAGE="$MATTERMOST_STAGE/package"; \
    test -f "$MATTERMOST_PACKAGE/dist/index.js"; \
    node -e 'const pkg = require(process.argv[1]); const version = process.argv[2]; if (pkg.name !== "@openclaw/mattermost" || pkg.version !== version) process.exit(1);' "$MATTERMOST_PACKAGE/package.json" "$OPENCLAW_CORE_VERSION"; \
    node -e 'const fs = require("node:fs"); const path = require("node:path"); const dir = process.argv[1]; const files = fs.readdirSync(dir).filter((name) => name.endsWith(".js")); const target = files.find((name) => fs.readFileSync(path.join(dir, name), "utf8").includes("import WebSocket from \"ws\";")); if (!target) throw new Error("Mattermost WebSocket runtime was not found"); const file = path.join(dir, target); fs.writeFileSync(file, fs.readFileSync(file, "utf8").replace("import WebSocket from \"ws\";", "import WebSocket from \"../node_modules/ws/index.js\";"));' "$MATTERMOST_PACKAGE/dist"; \
    MATTERMOST_BUNDLED_DIR="$OPENCLAW_ROOT/dist/extensions/mattermost"; \
    rm -rf "$MATTERMOST_BUNDLED_DIR"; \
    mkdir -p "$(dirname "$MATTERMOST_BUNDLED_DIR")"; \
    cp -a "$MATTERMOST_PACKAGE" "$MATTERMOST_BUNDLED_DIR"; \
    rm -rf "$MATTERMOST_STAGE"; \
    rm -f /tmp/oc-plugin.log /tmp/openclaw-mattermost-fork.tgz; \
    find /home/node/.openclaw/npm -type d -name _openclaw-pack-archives -prune -exec rm -rf '{}' +; \
    mkdir -p /opt/openclaw-runtime-deps; \
    cp -a /home/node/.openclaw/npm /opt/openclaw-runtime-deps/npm; \
    chown -R node:node /opt/openclaw-runtime-deps; \
    ! find /opt/openclaw-runtime-deps/npm -type d -path '*/node_modules/@openclaw/mattermost' | grep -q .; \
    find /opt/openclaw-runtime-deps/npm -type d -path '*/node_modules/@openclaw/parallel-plugin' | grep -q .; \
    ! find /opt/openclaw-runtime-deps/npm -type d -path '*/node_modules/@openclaw/codex' | grep -q .

FROM gateway-core-system AS gateway-core-runtime

COPY --from=openclaw-installer /usr/local/lib/node_modules/openclaw /usr/local/lib/node_modules/openclaw
COPY --from=openclaw-core-plugin-installer /usr/local/lib/node_modules/openclaw/dist/extensions/mattermost /usr/local/lib/node_modules/openclaw/dist/extensions/mattermost
RUN test "$(node -p "require('/usr/local/lib/node_modules/openclaw/package.json').bin.openclaw")" = "openclaw.mjs" \
    && ln -s ../lib/node_modules/openclaw/openclaw.mjs /usr/local/bin/openclaw \
    && openclaw --version
COPY --from=openclaw-core-plugin-installer --chown=node:node /opt/openclaw-runtime-deps /opt/openclaw-runtime-deps

FROM openclaw-core-plugin-installer AS openclaw-full-plugin-installer

RUN set -e; \
    OPENCLAW_ROOT="$(npm root -g)/openclaw"; \
    OPENCLAW_CORE_VERSION="$(node -e 'const pkg = require(process.argv[1]); process.stdout.write(pkg.version);' "$OPENCLAW_ROOT/package.json")"; \
    OC_VENDOR="$OPENCLAW_ROOT/vendor"; \
    if [ -f "$OC_VENDOR/openclaw-codex.tgz" ]; then \
      CODEX_REPACK="$(mktemp -d)"; \
      tar -xzf "$OC_VENDOR/openclaw-codex.tgz" -C "$CODEX_REPACK"; \
      node -e 'const fs = require("node:fs"); const [file, version] = process.argv.slice(1); const pkg = JSON.parse(fs.readFileSync(file, "utf8")); if (pkg.name !== "@openclaw/codex") throw new Error("unexpected vendored package"); pkg.version = version; fs.writeFileSync(file, JSON.stringify(pkg, null, 2) + "\n");' "$CODEX_REPACK/package/package.json" "$OPENCLAW_CORE_VERSION"; \
      (cd "$CODEX_REPACK/package" && npm pack --ignore-scripts --pack-destination "$CODEX_REPACK" > /tmp/oc-plugin.log 2>&1); \
      VENDORED_CODEX="$(find "$CODEX_REPACK" -maxdepth 1 -type f -name '*.tgz' -print -quit)"; \
      test -n "$VENDORED_CODEX"; \
      openclaw plugins install "npm-pack:$VENDORED_CODEX" --force --accept-capabilities > /tmp/oc-plugin.log 2>&1; \
      rm -rf "$CODEX_REPACK"; \
    else \
      openclaw plugins install "@openclaw/codex@${OPENCLAW_CORE_VERSION}" --accept-capabilities > /tmp/oc-plugin.log 2>&1; \
    fi \
      || { echo "FATAL: @openclaw/codex install failed"; tail -n 20 /tmp/oc-plugin.log; exit 1; }; \
    rm -f /tmp/oc-plugin.log; \
    find /home/node/.openclaw/npm -type d -name _openclaw-pack-archives -prune -exec rm -rf '{}' +; \
    rm -rf /opt/openclaw-runtime-deps; \
    mkdir -p /opt/openclaw-runtime-deps; \
    cp -a /home/node/.openclaw/npm /opt/openclaw-runtime-deps/npm; \
    chown -R node:node /opt/openclaw-runtime-deps; \
    CODEX_PACKAGE="$(find /opt/openclaw-runtime-deps/npm -type f -path '*/node_modules/@openclaw/codex/package.json' -print -quit)"; \
    test -n "$CODEX_PACKAGE"; \
    INSTALLED_CODEX="$(node -e 'const pkg = require(process.argv[1]); process.stdout.write(pkg.version);' "$CODEX_PACKAGE")"; \
    test "$INSTALLED_CODEX" = "$OPENCLAW_CORE_VERSION"; \
    ! find /opt/openclaw-runtime-deps/npm -type d -path '*/node_modules/@openclaw/mattermost' | grep -q .; \
    find /opt/openclaw-runtime-deps/npm -type d -path '*/node_modules/@openclaw/parallel-plugin' | grep -q .

FROM gateway-system AS gateway-runtime

COPY --from=openclaw-installer /usr/local/lib/node_modules/openclaw /usr/local/lib/node_modules/openclaw
COPY --from=openclaw-core-plugin-installer /usr/local/lib/node_modules/openclaw/dist/extensions/mattermost /usr/local/lib/node_modules/openclaw/dist/extensions/mattermost
RUN test "$(node -p "require('/usr/local/lib/node_modules/openclaw/package.json').bin.openclaw")" = "openclaw.mjs" \
    && ln -s ../lib/node_modules/openclaw/openclaw.mjs /usr/local/bin/openclaw \
    && openclaw --version
COPY --from=openclaw-full-plugin-installer --chown=node:node /opt/openclaw-runtime-deps /opt/openclaw-runtime-deps
