# ─────────────────────────────────────────────────────────────────────────────
# octogee-gateway-base — OpenClaw runtime + all heavy/stable deps
#
# Rebuild this ONLY when upgrading OpenClaw or changing system packages:
#   gcloud builds submit --config cloudbuild-base.yaml \
#     --substitutions=_OPENCLAW_VERSION=2026.4.5 \
#     --project=octogee
#
# What lives here (changes rarely → cached across gateway builds):
#   - OpenClaw npm install
#   - All apt packages (curl, jq, python3, chromium, git, vim, sqlite3, etc.)
#   - @huggingface/transformers (1.2GB — heaviest dep, almost never changes)
#   - octogee-router npm install (node_modules for the classifier extension)
# ─────────────────────────────────────────────────────────────────────────────
# Node 24 matches OpenClaw upstream's publishing + CI target image
# (node:24-bookworm-slim, per their Dockerfile). OpenClaw 2026.4.20's
# `engines.node` declares `>=22.14.0` as the hard floor, but the CI
# matrix runs primarily on 24.x with only partial 22.18 compat. Staying
# in lockstep with their ship target avoids "works on their CI, not on
# our pod" surprises and keeps us on the current LTS line. Unrelated
# services (`workspace-api` on GKE, `functions` on Firebase) stay on
# Node 22 — they're separate deploy surfaces with their own runtime
# constraints (Firebase Functions Node 24 support lags the runtime).
FROM node:24-bookworm-slim

# ── All system packages in one layer ────────────────────────────────────────
# Combining apt runs avoids duplicate update overhead and saves ~30s per build.
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Runtime essentials
    curl jq python3 \
    sqlite3 xxd rsync \
    ca-certificates \
    # Developer experience (available in running pod)
    bash-completion git vim less \
    && rm -rf /var/lib/apt/lists/*

# ── OpenClaw from npm ────────────────────────────────────────────────────────
ARG OPENCLAW_VERSION=latest
RUN npm install -g openclaw@${OPENCLAW_VERSION} && openclaw --version

# ── Non-root user ────────────────────────────────────────────────────────────
RUN groupadd -r node 2>/dev/null || true && \
    useradd -r -g node -d /home/node -m node 2>/dev/null || true

ENV HOME=/home/node

# ── Heavy extension deps — pre-installed in base (1.2GB, changes rarely) ────
# octogee-router needs @huggingface/transformers for the NN classifier.
# Installing here means gateway builds skip this entirely.
# Entrypoint symlinks /octogee/extensions/octogee-router/node_modules → here.
COPY infra/gateway/extensions/octogee-router/package.json \
     infra/gateway/extensions/octogee-router/package-lock.json* \
     /opt/octogee-router-deps/
RUN cd /opt/octogee-router-deps && npm install --production 2>&1 | tail -5 \
    && chown -R node:node /opt/octogee-router-deps

# ── Pre-bake classifier ONNX model into image ──────────────────────────────
# octogee-router's classifier needs Xenova/all-MiniLM-L6-v2 (~90MB fp32 ONNX)
# at runtime. Downloading at gateway boot from the HF CDN is unreliable:
#   - Partial writes corrupt the EmptyDir cache (poisons every subsequent boot)
#   - CDN hangs stall classifier init for 70+ seconds
#   - Plugin hot-reloads retrigger the same fetch, freezing the event loop
# Baking the model into the image makes classifier init fully offline.
# If the download or warm-up inference fails, the base image build fails loud.
RUN mkdir -p /opt/octogee-router-models && chown -R node:node /opt/octogee-router-models
COPY --chown=node:node infra/gateway/extensions/octogee-router/prebake-model.mjs \
     /opt/octogee-router-deps/prebake-model.mjs
USER node
RUN cd /opt/octogee-router-deps && node prebake-model.mjs
USER root
RUN rm /opt/octogee-router-deps/prebake-model.mjs \
    && ls -la /opt/octogee-router-models/Xenova/all-MiniLM-L6-v2/onnx/

# ── OpenClaw Mattermost plugin ───────────────────────────────────────────────
RUN openclaw plugins install @openclaw/mattermost 2>&1 | tail -3

# ── npm cache ownership (prevent EACCES in agent exec calls) ─────────────────
RUN mkdir -p /home/node/.npm && chown -R node:node /home/node/.npm
