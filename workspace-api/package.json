{
  "name": "@octogee/workspace-api",
  "version": "1.0.0",
  "description": "Octogee workspace API \u2014 consolidated HTTP service (ex Cloud Functions)",
  "main": "dist/workspace-api/src/index.js",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json && npm run verify:no-alias-leakage",
    "build:watch": "tsc --watch",
    "start": "node dist/workspace-api/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:no-alias-leakage": "! grep -rq --include='*.js' '@shared' dist/ || (echo '\u274c Found un-rewritten @shared/* alias in compiled JS. Fix: ensure tsc-alias is installed and the build script runs `tsc && tsc-alias -p tsconfig.json` (path alias rewriting must run after emit, or Node will fail at runtime with MODULE_NOT_FOUND).' && exit 1)"
  },
  "engines": {
    "node": "26"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.2",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.1",
    "firebase-admin": "^13.9.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "prom-client": "^15.1.3",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^25.9.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "@tootallnate/once": "^3.0.1",
    "fast-xml-builder": "^1.1.7",
    "ip-address": "^10.1.1",
    "protobufjs": "^7.5.6",
    "uuid": "^14.0.0"
  }
}
