{
  "name": "@octogee/core",
  "version": "1.0.0",
  "description": "Octogee shared runtime — consumers depend on its built interface, never its source.",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "exports": {
    "./auth-profile-sqlite": {
      "types": "./dist/auth-profile-sqlite.d.ts",
      "default": "./dist/auth-profile-sqlite.js"
    },
    "./byosub-onboarding": {
      "types": "./dist/byosub-onboarding.d.ts",
      "default": "./dist/byosub-onboarding.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./deploy-records": {
      "types": "./dist/deploy-records.d.ts",
      "default": "./dist/deploy-records.js"
    },
    "./firebase-auth-helpers": {
      "types": "./dist/firebase-auth-helpers.d.ts",
      "default": "./dist/firebase-auth-helpers.js"
    },
    "./firebase-hosting": {
      "types": "./dist/firebase-hosting.d.ts",
      "default": "./dist/firebase-hosting.js"
    },
    "./fleet-migration": {
      "types": "./dist/fleet-migration.d.ts",
      "default": "./dist/fleet-migration.js"
    },
    "./fleet-signature": {
      "types": "./dist/fleet-signature.d.ts",
      "default": "./dist/fleet-signature.js"
    },
    "./gitea-naming": {
      "types": "./dist/gitea-naming.d.ts",
      "default": "./dist/gitea-naming.js"
    },
    "./hosting": {
      "types": "./dist/hosting.d.ts",
      "default": "./dist/hosting.js"
    },
    "./secret-manager": {
      "types": "./dist/secret-manager.d.ts",
      "default": "./dist/secret-manager.js"
    },
    "./site-id": {
      "types": "./dist/site-id.d.ts",
      "default": "./dist/site-id.js"
    },
    "./workspace-slugs": {
      "types": "./dist/workspace-slugs.d.ts",
      "default": "./dist/workspace-slugs.js"
    }
  },
  "typesVersions": {
    "*": {
      "auth-profile-sqlite": ["dist/auth-profile-sqlite.d.ts"],
      "byosub-onboarding": ["dist/byosub-onboarding.d.ts"],
      "config": ["dist/config.d.ts"],
      "deploy-records": ["dist/deploy-records.d.ts"],
      "firebase-auth-helpers": ["dist/firebase-auth-helpers.d.ts"],
      "firebase-hosting": ["dist/firebase-hosting.d.ts"],
      "fleet-migration": ["dist/fleet-migration.d.ts"],
      "fleet-signature": ["dist/fleet-signature.d.ts"],
      "gitea-naming": ["dist/gitea-naming.d.ts"],
      "hosting": ["dist/hosting.d.ts"],
      "secret-manager": ["dist/secret-manager.d.ts"],
      "site-id": ["dist/site-id.d.ts"],
      "workspace-slugs": ["dist/workspace-slugs.d.ts"]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "pack:tarball": "npm run build && npm pack && mv -f octogee-core-*.tgz octogee-core.tgz",
    "verify:tarball": "bash verify-tarball.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.2.0",
    "firebase-admin": "^13.10.0 || ^14.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
