{
  "name": "@octogee/glm-controller",
  "version": "1.0.0",
  "description": "Gateway Lifecycle Manager — runs in-cluster, reconciles Firestore desired-state to Helm + drives migration operations",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/glm-controller/src/main.js",
  "scripts": {
    "prebuild": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "build": "tsc",
    "dev": "OCTOGEE_ALLOW_LOCAL_ORIGINS=true tsx src/main.ts",
    "start": "node dist/glm-controller/src/main.js",
    "pretest": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test": "K8S_NAMESPACE=octogee vitest run",
    "pretest:emulator": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test:emulator": "config=\"$PWD/vitest.emulator.config.ts\" && cd ../scripts && node ops/run-emulator-vitest.mjs --only firestore --project octogee-test --firebase-config ../../firebase.json --config \"$config\" --env GCLOUD_PROJECT=octogee-test",
    "pretypecheck": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@google-cloud/kms": "^6.3.0",
    "@octogee/core": "file:../core",
    "@octogee/product-core": "file:../../product/core",
    "@octogee/product-shared": "file:../../product/shared",
    "@octogee/shared": "file:../shared",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^11.0.2",
    "tsx": "^4.23.15",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "8.18.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "ws": "8.21.3"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
    "fast-xml-builder": "^1.1.7",
    "glob": "14.0.3",
    "uuid": "^11.1.1",
    "protobufjs": "^7.6.3",
    "qs": "^6.17.0",
    "postcss": "8.5.25"
  }
}
