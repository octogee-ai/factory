{
  "name": "@octogee/glm-controller",
  "version": "1.0.0",
  "description": "Gateway Lifecycle Manager \u2014 runs in-cluster, reconciles Firestore desired-state to Helm + drives migration operations",
  "private": true,
  "type": "module",
  "main": "dist/glm-controller/src/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/glm-controller/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.6.2",
    "tsx": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "fast-xml-builder": "^1.1.7",
    "glob": "^13.0.0"
  }
}
