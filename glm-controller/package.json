{
  "name": "@octogee/glm-controller",
  "version": "1.0.0",
  "description": "Gateway Lifecycle Manager — runs in-cluster, reconciles Firestore desired-state to Helm + drives migration operations",
  "private": true,
  "type": "module",
  "main": "dist/glm-controller/src/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/glm-controller/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octogee/core": "file:../core/octogee-core.tgz",
    "@octogee/shared": "file:../shared/octogee-shared.tgz",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.9.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "fast-xml-builder": "^1.1.7",
    "glob": "^13.0.0",
    "uuid": "^11.1.1",
    "protobufjs": "^7.6.3"
  }
}
