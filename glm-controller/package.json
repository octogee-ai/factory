{
  "name": "@octogee/glm-controller",
  "version": "1.0.0",
  "description": "Gateway Lifecycle Manager \u2014 runs in-cluster, reconciles Firestore desired-state to Helm + drives migration operations",
  "private": true,
  "type": "module",
  "main": "dist/glm-controller/src/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/glm-controller/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.2",
    "express": "^4.21.0",
    "firebase-admin": "^13.8.0",
    "google-auth-library": "^10.6.2",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.2.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.4"
  }
}
