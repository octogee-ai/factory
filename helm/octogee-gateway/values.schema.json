{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "octogee-gateway values",
  "description": "Defense-in-depth schema for the per-gateway chart. Catches shape errors (wrong type, missing required key, unknown profile) BEFORE template logic runs. Platform secrets are intentionally absent from the gatewayEdge values surface.",
  "type": "object",
  "required": ["gatewayId", "imageTag", "image", "gatewayEdge"],
  "properties": {
    "gatewayId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 32,
      "description": "Bare logical gateway identity (e.g. `default`, `bender`). Used in Firestore heartbeats, the per-gateway K8s auth-token secret name, and as the DNS-friendly suffix for per-instance K8s resource names (Deployment, Service, PVC)."
    },
    "imageTag": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "enum": ["", "standard", "operator"],
      "description": "Capability profile. Empty + 'standard' are equivalent cattle behavior; 'operator' enables pet-home defaults and platform-secret withholding. Shells require operatorAccess.shellsEnabled."
    },
    "replicas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "Replica count for the gateway Deployment. 0 = paused (Cowboy sets this for desiredStatus=paused); 1 = running. HPA / multi-replica is GATEWAY-PLATFORM-SPEC §Phase 6, out of scope here."
    },
    "sizingTier": {
      "type": "string",
      "enum": ["", "nano", "small", "medium", "large", "xlarge", "2xlarge"],
      "description": "Per-pod sizing tier. Empty = fall back to profileDefaults[profile]."
    },
    "profileDefaults": {
      "type": "object",
      "description": "Profile → default tier mapping. Used when sizingTier is unset. `standard` is required — the effectiveTier helper falls back to it as the last-resort default.",
      "required": ["standard"],
      "properties": {
        "standard": { "type": "string", "enum": ["nano", "small", "medium", "large", "xlarge", "2xlarge"] },
        "operator": { "type": "string", "enum": ["nano", "small", "medium", "large", "xlarge", "2xlarge"] }
      },
      "additionalProperties": { "type": "string" }
    },
    "tiers": {
      "type": "object",
      "description": "Tier preset matrix — resources + Node runtime tuning per tier. Mirrored in shared/types/sizing.ts. All six tier keys are required so a typo or trim doesn't leave effectiveTier pointing at a missing preset.",
      "required": ["nano", "small", "medium", "large", "xlarge", "2xlarge"],
      "additionalProperties": {
        "type": "object",
        "required": ["resources", "nodejs"],
        "properties": {
          "resources": {
            "type": "object",
            "required": ["requests", "limits"],
            "properties": {
              "requests": { "type": "object", "additionalProperties": true },
              "limits": { "type": "object", "additionalProperties": true }
            }
          },
          "nodejs": {
            "type": "object",
            "required": ["uvThreadpoolSize", "maxOldSpaceSizeMb"],
            "properties": {
              "uvThreadpoolSize": { "type": "string" },
              "maxOldSpaceSizeMb": { "type": "string" }
            }
          }
        }
      }
    },
    "chartFingerprint": {
      "type": "string"
    },
    "serviceAccountName": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true
    },
    "operatorAccess": {
      "type": "object",
      "properties": {
        "shellsEnabled": { "type": "boolean" },
        "platformMetadataEgress": { "type": "boolean", "description": "Platform-builder D7 carve-out: open egress to the GKE metadata server (169.254.169.254) for this gateway's read-only WI GSA. Default off; the fleet-wide gateway-egress policy blocks metadata for every other gateway." },
        "reason": { "type": "string" },
        "verifiedAt": { "type": "number" },
        "verifiedBy": { "type": "string" }
      },
      "additionalProperties": true
    },
    "computeClass": {
      "type": "string"
    },
    "machineFamily": {
      "type": "string"
    },
    "gatewayContainerSecurityContext": {
      "type": "object"
    },
    "env": {
      "type": "object",
      "additionalProperties": true
    },
    "preview": {
      "type": "object",
      "additionalProperties": true
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClassName": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "size": { "type": "string" }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": true
    },
    "pdb": {
      "type": "object",
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" }
      }
    },
    "gatewayEdge": {
      "type": "object",
      "required": ["enabled", "port", "image", "env"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": ["integer", "string"] },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
